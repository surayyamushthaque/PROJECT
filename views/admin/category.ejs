<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Categories - Admin Panel</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .page-wrapper {
      padding: 40px 32px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .card {
      background: #fff;
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 2px 16px rgba(0,0,0,0.07);
    }

    /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .header-left h1 {
      font-size: 28px;
      font-weight: 700;
      color: #111827;
    }

    .header-left p {
      font-size: 14px;
      color: #6b7280;
      margin-top: 4px;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .search-box {
      display: flex;
      align-items: center;
      border: 1.5px solid #e5e7eb;
      border-radius: 8px;
      padding: 8px 14px;
      background: #fff;
      gap: 8px;
      min-width: 240px;
    }

    .search-box input {
      border: none;
      outline: none;
      font-size: 14px;
      color: #374151;
      width: 100%;
      background: transparent;
    }

    .search-box input::placeholder { color: #9ca3af; }

    .search-icon { color: #9ca3af; font-size: 16px; }

    .btn-add {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #16a34a;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 10px 20px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s;
      white-space: nowrap;
    }

    .btn-add:hover { background: #15803d; }

    /* Flash messages */
    .alert {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-size: 14px;
      font-weight: 500;
    }

    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .alert-error   { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead tr {
      border-bottom: 1.5px solid #e5e7eb;
    }

    thead th {
      text-align: left;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: #6b7280;
      padding: 12px 16px;
      text-transform: uppercase;
    }

    tbody tr {
      border-bottom: 1px solid #f3f4f6;
      transition: background 0.15s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f9fafb; }

    tbody td {
      padding: 16px;
      font-size: 14px;
      color: #374151;
      vertical-align: middle;
    }

    .row-num { color: #9ca3af; font-weight: 600; }

    /* Category cell */
    .cat-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cat-img {
      width: 48px;
      height: 48px;
      border-radius: 8px;
      object-fit: cover;
      border: 1px solid #e5e7eb;
      background: #f3f4f6;
    }

    .cat-name {
      font-weight: 600;
      color: #111827;
    }

    /* View button */
    .btn-view {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1.5px solid #d1d5db;
      border-radius: 6px;
      padding: 6px 14px;
      font-size: 13px;
      color: #374151;
      background: #fff;
      cursor: pointer;
      text-decoration: none;
      transition: border-color 0.2s, background 0.2s;
    }

    .btn-view:hover { border-color: #9ca3af; background: #f9fafb; }

    /* Offer */
    .offer-wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }

    .badge-offer {
      display: inline-block;
      background: #111827;
      color: #fff;
      border-radius: 6px;
      padding: 2px 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .btn-offer-add {
      border: 1.5px solid #d1d5db;
      border-radius: 6px;
      padding: 3px 12px;
      font-size: 12px;
      color: #374151;
      background: #fff;
      cursor: pointer;
      transition: border-color 0.2s;
    }

    .btn-offer-add:hover { border-color: #16a34a; color: #16a34a; }

    .btn-offer-remove {
      border: 1.5px solid #ef4444;
      border-radius: 6px;
      padding: 3px 12px;
      font-size: 12px;
      color: #ef4444;
      background: #fff;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-offer-remove:hover { background: #fee2e2; }

    /* Status badge */
    .badge-listed {
      display: inline-block;
      background: #dcfce7;
      color: #16a34a;
      border-radius: 20px;
      padding: 4px 14px;
      font-size: 13px;
      font-weight: 600;
    }

    .badge-unlisted {
      display: inline-block;
      background: #fee2e2;
      color: #dc2626;
      border-radius: 20px;
      padding: 4px 14px;
      font-size: 13px;
      font-weight: 600;
    }

    /* Action buttons */
    .actions-cell { display: flex; align-items: center; gap: 8px; }

    .btn-icon {
      width: 34px;
      height: 34px;
      border-radius: 6px;
      border: 1.5px solid #e5e7eb;
      background: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
      text-decoration: none;
    }

    .btn-icon.danger { border-color: #fca5a5; }
    .btn-icon.danger:hover { background: #fee2e2; border-color: #ef4444; }
    .btn-icon.edit  { border-color: #bfdbfe; }
    .btn-icon.edit:hover { background: #eff6ff; border-color: #3b82f6; }

    .btn-icon svg { width: 16px; height: 16px; }

    /* Pagination */
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 28px;
    }

    .page-btn {
      width: 36px;
      height: 36px;
      border-radius: 6px;
      border: 1.5px solid #e5e7eb;
      background: #fff;
      font-size: 14px;
      font-weight: 500;
      color: #374151;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }

    .page-btn:hover { background: #f3f4f6; }

    .page-btn.active {
      background: #2563eb;
      border-color: #2563eb;
      color: #fff;
    }

    .page-btn.next { padding: 0 14px; width: auto; }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #9ca3af;
    }

    .empty-state p { font-size: 15px; margin-top: 8px; }
  </style>
    <%- include("../partials/sidebar") %>
</head>
<body>

<div class="page-wrapper">
  <div class="card">

    <!-- Header -->
    <div class="header">
      <div class="header-left">
        <h1>Categories</h1>
        <p>Manage your product categories</p>
      </div>
      <div class="header-right">
        <form method="GET" action="/admin/category" style="display:flex;">
          <div class="search-box">
            <span class="search-icon">&#128269;</span>
            <input
              type="text"
              name="search"
              placeholder="Search categories..."
              value="<%= typeof search !== 'undefined' ? search : '' %>"
            />
          </div>
        </form>
        <a href="/admin/Category/add" class="btn-add">
          &#43; Add Category
        </a>
      </div>
    </div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success"><%= successMessage %></div>
    <% } %>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-error"><%= errorMessage %></div>
    <% } %>

    <!-- Table -->
    <% if (categories && categories.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Category</th>
          <th>Description</th>
          <th>Offer</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach((cat, index) => { %>
        <tr>
          <!-- Row number (accounts for pagination) -->
          <td class="row-num">
            <%= (currentPage - 1) * limit + index + 1 %>
          </td>

          <!-- Category name + image -->
          <td>
            <div class="cat-cell">
              <img
                class="cat-img"
                src="<%= cat.image ? '/uploads/category/' + cat.image : '/images/placeholder.png' %>"
                alt="<%= cat.name %>"
              />
              <span class="cat-name"><%= cat.name %></span>
            </div>
          </td>

          <!-- Description view button -->
          <td>
            <a href="/admin/Category/<%= cat._id %>" class="btn-view">
              <!-- eye icon -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              View
            </a>
          </td>

          <!-- Offer -->
          <td>
            <div class="offer-wrap">
              <span class="badge-offer">
                <%= cat.offer ? cat.offer + '%' : '0%' %>
              </span>
              <% if (cat.offer && cat.offer > 0) { %>
                <form method="POST" action="/admin/categories/<%= cat._id %>/remove-offer" style="display:inline;">
                  <button type="submit" class="btn-offer-remove">Remove</button>
                </form>
              <% } else { %>
                <a href="/admin/categories/<%= cat._id %>/add-offer" class="btn-offer-add">Add</a>
              <% } %>
            </div>
          </td>

          <!-- Status -->
          <td>
            <% if (cat.isListed) { %>
              <span class="badge-listed">Listed</span>
            <% } else { %>
              <span class="badge-unlisted">Unlisted</span>
            <% } %>
          </td>

          <!-- Actions -->
          <td>
            <div class="actions-cell">
              <!-- Block / Unblock -->
              <form
                method="POST"
                action="/admin/categories/<%= cat._id %>/<%= cat.isListed ? 'unlist' : 'list' %>"
                style="display:inline;"
                onsubmit="return confirm('<%= cat.isListed ? 'Unlist' : 'List' %> this category?')"
              >
                <button type="submit" class="btn-icon danger" title="<%= cat.isListed ? 'Unlist' : 'List' %>">
                  <!-- block icon -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                  </svg>
                </button>
              </form>

              <!-- Edit -->
              <a href="/admin/categories/<%= cat._id %>/edit" class="btn-icon edit" title="Edit">
                <!-- pencil icon -->
                <svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
              </a>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a
          href="/admin/categories?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %>"
          class="page-btn <%= currentPage === i ? 'active' : '' %>"
        ><%= i %></a>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a
          href="/admin/categories?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %>"
          class="page-btn next"
        >Next &raquo;</a>
      <% } %>
    </div>
    <% } %>

    <% } else { %>
    <div class="empty-state">
      <svg width="48" height="48" fill="none" stroke="#d1d5db" stroke-width="1.5" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
      </svg>
      <p>No categories found. <a href="/admin/categories/add" style="color:#16a34a;">Add one now</a>.</p>
    </div>
    <% } %>

  </div><!-- /card -->
</div><!-- /page-wrapper -->

</body>
</html>
