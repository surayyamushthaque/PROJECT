<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>User Management</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: url('/images/login-bg.jpg') no-repeat center center/cover;
    position: relative;
  }
  body::before {
    content: "";
    position: fixed;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 0;
  }

  .top-header {
    background: #e8e8e8;
    padding: 12px 28px;
    border-bottom: 2px solid #3a3aff;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 100;
  }
  .brand {
    font-family: 'Arial Black', Arial, sans-serif;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    gap: 1px;
    text-decoration: none;
  }
  .brand-dot {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid #1a1a1a;
    margin: 0 2px;
    flex-shrink: 0;
  }

  .layout-wrapper { flex: 1; display: flex; position: relative; z-index: 1; }
  .sidebar {
    width: 230px;
    min-height: 100%;
    background: rgba(11, 19, 43, 0.92);
    color: white;
    padding: 20px;
    flex-shrink: 0;
    backdrop-filter: blur(4px);
  }
  .sidebar h4 {
    margin-bottom: 30px;
    font-family: 'Arial Black', Arial, sans-serif;
    letter-spacing: 0.1em;
  }
  .sidebar a {
    display: block;
    color: white;
    margin: 10px 0;
    text-decoration: none;
    padding: 8px 10px;
    border-radius: 8px;
  }
  .sidebar a:hover { color: #00d4ff; }
  .sidebar a.active {
    background: rgba(255,255,255,0.12);
    color: #00d4ff;
  }

  .main { flex: 1; padding: 20px; overflow-y: auto; }
  .topbar {
    background: rgba(255, 255, 255, 0.92);
    padding: 10px 20px;
    border-radius: 10px;
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    backdrop-filter: blur(4px);
    gap: 12px;
    flex-wrap: wrap;
  }
  .table-box {
    background: rgba(255, 255, 255, 0.92);
    padding: 20px;
    border-radius: 10px;
    backdrop-filter: blur(4px);
  }

  .loading-pill {
    display: none;
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(0,0,0,0.08);
  }
  .loading .loading-pill { display: inline-block; }
</style>
</head>

<body>

<!-- HEADER -->
<header class="top-header">
  <a class="brand" href="/admin/dashboard">CHR<span class="brand-dot"></span>NIC</a>
  <div class="ms-auto">
    <a class="btn btn-sm btn-outline-dark" href="/admin/logout">Logout</a>
  </div>
</header>

<div class="layout-wrapper">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <h4>ADMIN</h4>
    <a href="/admin/dashboard">Dashboard</a>
    <a class="active" href="/admin/users">Users</a>
    <a href="/admin/logout">Logout</a>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <div class="topbar" id="topbar">
      <div>
        <h5 class="mb-0">User Management</h5>
        <!-- <small class="text-muted">Search, sort (latest first), block/unblock</small> -->
      </div>

      <div class="d-flex gap-2 align-items-center flex-wrap">
        <span class="loading-pill" id="loadingPill">Loading…</span>
        <input
          type="text"
          id="searchInput"
          class="form-control"
          style="min-width: 260px;"
          placeholder="Search by name or email…"
          value="<%= search %>"
        />
        <button type="button" class="btn btn-outline-dark" id="btnClear">Clear</button>
      </div>
    </div>

    <div class="table-box">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Joined</th>
              <th>User</th>
              <th>Phone</th>
              <th>Status</th>
              <th style="width: 160px;">Action</th>
            </tr>
          </thead>
          <tbody id="usersTbody">
            <% if (users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr data-user-id="<%= u._id %>">
                  <td><%= u.createdAt ? new Date(u.createdAt).toLocaleDateString() : 'N/A' %></td>
                  <td>
                    <div class="fw-semibold"><%= u.name %></div>
                    <div class="text-muted" style="font-size: 12px;"><%= u.email %></div>
                  </td>
                  <td><%= u.phone || 'N/A' %></td>
                  <td>
                    <% if (u.isBlocked) { %>
                      <span class="badge text-bg-danger js-status">Blocked</span>
                    <% } else { %>
                      <span class="badge text-bg-success js-status">Active</span>
                    <% } %>
                  </td>
                  <td>
                    <button
                      type="button"
                      class="btn btn-sm <%= u.isBlocked ? 'btn-outline-success' : 'btn-outline-danger' %> js-toggle-block"
                      data-user-id="<%= u._id %>"
                      data-is-blocked="<%= u.isBlocked ? '1' : '0' %>"
                    >
                      <%= u.isBlocked ? 'Unblock' : 'Block' %>
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center text-muted py-4">No users found</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <div class="text-muted" style="font-size: 13px;">
          Showing
          <b><%= total === 0 ? 0 : (page - 1) * limit + 1 %>–<%= Math.min(page * limit, total) %></b>
          of <b><%= total %></b>
        </div>

        <nav aria-label="Users pagination">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="/admin/users?search=<%= encodeURIComponent(search || '') %>&page=<%= Math.max(1, page-1) %>&limit=<%= limit %>">Prev</a>
            </li>

            <% for (let p = 1; p <= totalPages; p++) { %>
              <li class="page-item <%= p === page ? 'active' : '' %>">
                <a class="page-link" href="/admin/users?search=<%= encodeURIComponent(search || '') %>&page=<%= p %>&limit=<%= limit %>"><%= p %></a>
              </li>
            <% } %>

            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="/admin/users?search=<%= encodeURIComponent(search || '') %>&page=<%= Math.min(totalPages, page+1) %>&limit=<%= limit %>">Next</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </main>
</div>

<!-- SCRIPT -->
<script>
 
const searchInput = document.getElementById("searchInput");
const btnClear = document.getElementById("btnClear");
const loadingPill = document.getElementById("loadingPill");
const topbar = document.getElementById("topbar");

let debounceTimer;

// CLEAR BUTTON
btnClear.addEventListener("click", () => {
  searchInput.value = "";
  window.location.href = "/admin/users";
});

// DEBOUNCE SEARCH
searchInput.addEventListener("input", function () {
  const query = this.value.trim();

  clearTimeout(debounceTimer);
  topbar.classList.add("loading");

  debounceTimer = setTimeout(() => {
    const params = new URLSearchParams(window.location.search);
    params.set("search", query);
    params.set("page", "1");
    params.set("limit", "<%= limit %>");
    window.location.href = `/admin/users?${params.toString()}`;
  }, 500);
});

async function toggleBlock(userId, isBlocked) {
  const action = isBlocked ? "unblock" : "block";

  const result = await Swal.fire({
    icon: "warning",
    title: `Confirm ${action}`,
    text: `Are you sure you want to ${action} this user?`,
    showCancelButton: true,
    confirmButtonText: `Yes, ${action}`,
    cancelButtonText: "Cancel",
    confirmButtonColor: "#000"
  });

  if (!result.isConfirmed) return;

  try {
    loadingPill.textContent = "Updating…";
    topbar.classList.add("loading");

    const res = await fetch(`/admin/user/block/${userId}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" }
    });

    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      throw new Error(data.message || "Failed to update user");
    }

    const data = await res.json().catch(() => ({}));
    const nowBlocked = Boolean(data.isBlocked);

    const row = document.querySelector(`tr[data-user-id="${userId}"]`);
    const statusEl = row?.querySelector(".js-status");
    const btn = row?.querySelector(".js-toggle-block");

    if (statusEl) {
      statusEl.className = `badge js-status ${nowBlocked ? "text-bg-danger" : "text-bg-success"}`;
      statusEl.textContent = nowBlocked ? "Blocked" : "Active";
    }

    if (btn) {
      btn.dataset.isBlocked = nowBlocked ? "1" : "0";
      btn.className = `btn btn-sm js-toggle-block ${nowBlocked ? "btn-outline-success" : "btn-outline-danger"}`;
      btn.textContent = nowBlocked ? "Unblock" : "Block";
    }

    await Swal.fire({
      icon: "success",
      title: "Updated",
      text: nowBlocked ? "User blocked successfully" : "User unblocked successfully",
      timer: 1400,
      showConfirmButton: false
    });

  } catch (err) {
    Swal.fire({ icon: "error", title: "Error", text: err.message || "Something went wrong" });
  } finally {
    topbar.classList.remove("loading");
  }
}

document.querySelectorAll(".js-toggle-block").forEach((btn) => {
  btn.addEventListener("click", () => {
    const userId = btn.dataset.userId;
    const isBlocked = btn.dataset.isBlocked === "1";
    toggleBlock(userId, isBlocked);
  });
});
</script>

</body>
</html>