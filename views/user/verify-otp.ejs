<%- include("../partials/header", { title: "Verify OTP", user: user }) %>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
  <div class="card shadow-lg p-4" style="width: 420px; max-width: 95vw; border-radius: 15px;">

    <h3 class="text-center mb-2">Verify OTP</h3>
    <p class="text-center text-muted mb-4">Enter the 6-digit OTP sent to your email</p>

    <div class="mb-3">
      <label>OTP</label>
      <input id="otp" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" class="form-control" placeholder="Enter OTP">
      <small id="error-otp" class="text-danger"></small>
    </div>

    <button id="confirmBtn" class="btn btn-dark w-100">Confirm</button>

    <div class="d-flex justify-content-between align-items-center mt-3">
      <small class="text-muted">Resend available in <span id="timer" class="fw-semibold">00:30</span></small>
      <button id="resendOTP" class="btn btn-outline-dark btn-sm" disabled>Resend OTP</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
const confirmBtn = document.getElementById("confirmBtn");
const resendBtn = document.getElementById("resendOTP");
const timerDisplay = document.getElementById("timer");
const otpInput = document.getElementById("otp");
const otpError = document.getElementById("error-otp");

let countdown;
// Match backend resend throttle (userController.js uses 30s)
const RESEND_COOLDOWN_SECONDS = 30;
let timeLeft = RESEND_COOLDOWN_SECONDS;

function formatTime(sec) {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
}

function startTimer() {
  clearInterval(countdown);
  timeLeft = RESEND_COOLDOWN_SECONDS;
  resendBtn.disabled = true;
  timerDisplay.textContent = formatTime(timeLeft);

  countdown = setInterval(() => {
    timeLeft--;
    timerDisplay.textContent = formatTime(Math.max(0, timeLeft));

    if (timeLeft <= 0) {
      clearInterval(countdown);
      resendBtn.disabled = false;
      timerDisplay.textContent = "now";
    }
  }, 1000);
}

document.addEventListener("DOMContentLoaded", startTimer);

resendBtn.addEventListener("click", async () => {
  try {
    resendBtn.disabled = true;
    const res = await axios.post("/user/resend-otp");

    if (window.Swal) {
      await Swal.fire({
        icon: "success",
        title: "OTP resent",
        text: res.data?.message || "A new OTP was sent to your email.",
        timer: 1600,
        showConfirmButton: false
      });
    }

    startTimer();
  } catch (err) {
    const msg = err.response?.data?.error || "Could not resend OTP";
    // If backend says "Please wait...", restart cooldown to avoid rapid retries
    if (/wait/i.test(msg)) startTimer();
    else resendBtn.disabled = false;

    if (window.Swal) {
      return Swal.fire({ icon: "error", title: "Resend failed", text: msg });
    }
    alert(msg);
  }
});

confirmBtn.addEventListener("click", async () => {
  otpError.textContent = "";
  const otp = otpInput.value.trim();

  if (!otp || otp.length !== 6) {
    otpError.textContent = "Please enter a valid 6-digit OTP.";
    return;
  }

  try {
    confirmBtn.disabled = true;
    await axios.post("/user/verify-otp", { otp });

    if (window.Swal) {
      await Swal.fire({
        icon: "success",
        title: "Verified",
        text: "Account created successfully.",
        timer: 1400,
        showConfirmButton: false
      });
    }

    window.location.href = "/user/login";
  } catch (err) {
    const msg = err.response?.data?.error || "Invalid OTP";
    if (window.Swal) {
      Swal.fire({ icon: "error", title: "Verification failed", text: msg });
    }
    otpError.textContent = msg;
  } finally {
    confirmBtn.disabled = false;
  }
});
</script>

<%- include("../partials/footer") %>