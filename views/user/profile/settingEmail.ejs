<%- include("../../partials/headers", { title: "Verify Email", user: user }) %>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
  <div class="card shadow-lg p-4" style="width: 420px; max-width: 95vw; border-radius: 15px;">
    <h3 class="text-center mb-2">Verify Email</h3>
    <p class="text-center text-muted mb-4">Enter the OTP sent to your new email</p>

    <% if (error) { %>
      <div class="text-danger text-center mb-3"><%= error %></div>
    <% } %>

    <form action="/profile/verify-otp" method="POST">
      <div class="mb-3">
        <label>New email</label>
        <input type="email" name="newEmail" class="form-control" value="<%= pendingEmail %>" readonly />
        <small class="text-muted">We sent a 6-digit OTP to this address.</small>
      </div>

      <div class="mb-3">
        <label>OTP</label>
        <input type="text" name="otp" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
      </div>

      <button type="submit" class="btn btn-dark w-100">Verify & Update</button>
      <a href="/profile/edit" class="btn btn-outline-dark w-100 mt-2">Back</a>
    </form>
  </div>
</div>

<%- include("../../partials/footer") %>