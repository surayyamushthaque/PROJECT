<%- include("../../partials/header", { user: user }) %>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
  <div class="card shadow-lg p-4" style="width: 500px; max-width: 95vw; border-radius: 15px;">
    <h3 class="text-center mb-2">Edit Address</h3>
    <p class="text-center text-muted mb-4">Update your saved address</p>

    <% if (message) { %>
      <div class="text-center mb-3" style="color:<%= message.type === 'success' ? 'green' : 'red' %>">
        <%= message.text %>
      </div>
    <% } %>
    <style>
        body {
          background-color: #d59a9a;
          }
     </style>

    <form action="/user/addresses/edit/<%= address._id %>" method="POST" onsubmit="return validateEditAddress()">
      <div class="mb-2">
        <label>Full Name</label>
        <input type="text" name="name" class="form-control" value="<%= address.name %>" required>
      </div>
      <div class="mb-2">
        <label>Phone</label>
        <input type="text" id="phone" name="phone" class="form-control" value="<%= address.phone %>" required>
        <small id="err-phone" class="text-danger"></small>
      </div>
      <div class="mb-2">
        <label>Address Line (Street)</label>
        <input type="text" name="street" class="form-control" value="<%= address.street %>" required>
      </div>
      <div class="mb-2">
        <label>City</label>
        <input type="text" name="city" class="form-control" value="<%= address.city %>" required>
      </div>
      <div class="mb-2">
        <label>State</label>
        <input type="text" name="state" class="form-control" value="<%= address.state %>" required>
      </div>
      <div class="mb-2">
        <label>Pincode / ZIP</label>
        <input type="text" id="pincode" name="pincode" class="form-control" value="<%= address.pincode %>" required>
        <small id="err-pin" class="text-danger"></small>
      </div>
      <div class="mb-2">
        <label>Country</label>
        <input type="text" name="country" class="form-control" value="<%= address.country %>" required>
      </div>
      <div class="mb-3">
        <label>Landmark (optional)</label>
        <input type="text" name="landmark" class="form-control" value="<%= address.landmark || '' %>">
      </div>

      <button type="submit" class="btn btn-dark w-100">Save Changes</button>
      <a href="/user/profile" class="btn btn-outline-dark w-100 mt-2">Back</a>
    </form>
  </div>
</div>

<script>
function validateEditAddress() {
  const phone = (document.getElementById("phone").value || "").trim();
  const pin = (document.getElementById("pincode").value || "").trim();
  const ePhone = document.getElementById("err-phone");
  const ePin = document.getElementById("err-pin");
  ePhone.textContent = "";
  ePin.textContent = "";

  let ok = true;
  if (!/^\+?[0-9]{10,15}$/.test(phone)) {
    ePhone.textContent = "Enter a valid phone number";
    ok = false;
  }
  if (!/^[0-9]{4,10}$/.test(pin)) {
    ePin.textContent = "Pincode / ZIP must be numeric";
    ok = false;
  }
  return ok;
}
</script>
</body>
</html>
<%- include("../../partials/footer") %>

